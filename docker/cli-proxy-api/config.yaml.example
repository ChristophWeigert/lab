# Copy to config.yaml and set real secrets.
port: 8317
auth-dir: "/root/.cli-proxy-api"

# Management UI: https://cliproxy.<DOMAIN>/management.html
remote-management:
  allow-remote: true          # needed since requests arrive via Traefik
  secret-key: "CHANGE_ME"     # login key for the UI (hashed on first start)
  disable-control-panel: false

# Keys clients use to call the proxy API
api-keys:
  - "CHANGE_ME_CLIENT_KEY"
